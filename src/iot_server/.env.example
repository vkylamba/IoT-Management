# Django core
DJANGO_SECRET_KEY=change-me-to-a-strong-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8113

# Superuser bootstrap (used by startup scripts/management commands if configured)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# MongoDB (primary Django DB)
MONGODB_USERNAME=root
MONGODB_PASSWORD=example
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_NAME=mongotestdb

# ClickHouse (time-series/analytics)
CLICKHOUSE_DATABASE_HOST=database-clickhouse
CLICKHOUSE_DATABASE_PORT=8123
CLICKHOUSE_DATABASE_NAME=iotdatabase
CLICKHOUSE_DATABASE_USERNAME=root
CLICKHOUSE_DATABASE_PASSWORD=root

# Redis (cache + channels)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Application tuning
DEVICE_CACHE_TTL_MINUTES=10
WEATHER_DATA_CACHE_MINUTES=30
DEFAULT_SYNC_FREQUENCY_MINUTES=10

# Optional integrations
OPENWEATHERMAP_API_KEY=
TELEGRAM_BOT_TOKEN=
SUPERSET_ENABLED=False
SENTRY_DSN=

# Email (Mailgun for report delivery). When both are set, Django uses Mailgun automatically.
# DEFAULT_FROM_EMAIL must use an address on MAILGUN_SENDER_DOMAIN (or an authorized Mailgun domain).
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
# Use https://api.eu.mailgun.net/v3 for EU-region Mailgun accounts
MAILGUN_API_URL=https://api.mailgun.net/v3
DEFAULT_FROM_EMAIL=iot-reports@localhost
REPORT_PUBLIC_BASE_URL=
# Optional: force SMTP or console instead of auto Mailgun
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# MQTT client settings
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_USE_SSL=False
ROOT_CA=
